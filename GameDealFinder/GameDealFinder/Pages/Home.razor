@page "/"
@using GameDealFinder.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>GameDealFinder</PageTitle>

<h1>GameDealFinder</h1>

<p>Find the best deals on PC games.</p>

@if (!string.IsNullOrEmpty(error))
{
    <p>Error: @error</p>
}
else if (deals == null)
{
    <p>Loading deals...</p>
}
else if (deals.Count == 0)
{
    <p>No deals found.</p>
}
else
{
    @foreach (var deal in deals)
    {
        <div class="deal">
            <img src="@deal.Thumb" alt="@deal.Title" width="150" />

            <h3>@deal.Title</h3>
            <p>Sale price: $@deal.SalePrice</p>
            <p>Normal price: $@deal.NormalPrice</p>
            <p>Store: @GetStoreName(deal.StoreID)</p>
        </div>
    }
}

@if (deals != null && deals.Count > 0)
{
    <div>
        <button @onclick="PreviousPage" disabled="@(currentPage == 0)">
            Previous
        </button>

        <span>Page @(currentPage + 1)</span>

        <button @onclick="NextPage">
            Next
        </button>
    </div>
}

@code {
    private List<Deal>? deals;
    private List<Store> stores = new List<Store>();
    private string error = "";

    private int currentPage = 0;
    private int pageSize = 30;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeals();
    }

    // Load deals for the selected page
    private async Task LoadDeals()
    {
        try
        {
            error = "";
            deals = null;

            deals = await Http.GetFromJsonAsync<List<Deal>>(
                $"deals?sortBy=DealRating&pageSize={pageSize}&pageNumber={currentPage}");

            stores = await Http.GetFromJsonAsync<List<Store>>("stores")
                ?? new List<Store>();

            if (deals == null)
            {
                deals = new List<Deal>();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
            deals = new List<Deal>();
        }
    }

    // Move to the next page
    private async Task NextPage()
    {
        currentPage++;
        await LoadDeals();
    }

    // Move to the previous page
    private async Task PreviousPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadDeals();
        }
    }

    private string GetStoreName(string storeID)
    {
        var store = stores.FirstOrDefault(s => s.storeID == storeID);

        if (store == null)
        {
            return "Unknown store";
        }

        return store.storeName;
    }
}
