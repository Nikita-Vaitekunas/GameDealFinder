@page "/"
@using GameDealFinder.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>GameDealFinder</PageTitle>

<h1>GameDealFinder</h1>

<p>Find the best deals on PC games.</p>

<h2>Search Games</h2>

<input @bind="searchTitle" placeholder="Enter a game title..." />

<button @onclick="SearchGames">Search</button>
<button @onclick="ClearSearch">Clear</button>

<h2>Sort Deals</h2>

<select @bind="sortBy">
    <option value="DealRating">Best Deal Rating</option>
    <option value="Price">Cheapest Price</option>
    <option value="Savings">Biggest Savings</option>
</select>

<button @onclick="ApplySort">Apply</button>

<h2>Filter by Store</h2>

<select @bind="selectedStore">
    <option value="">All Stores</option>

    @foreach (var store in stores)
    {
        <option value="@store.storeID">@store.storeName</option>
    }
</select>

<button @onclick="ApplyStoreFilter">Apply</button>

<h2>Filter by Price</h2>

<input type="number" @bind="minPrice" min="0"
       placeholder="Minimum price..." />

<input type="number" @bind="maxPrice" min="0"
       placeholder="Maximum price..." />

<button @onclick="ApplyPriceFilter">Apply</button>

<h2>Minimum Discount</h2>

<input type="number" @bind="minDiscount" min="0" max="100"
       placeholder="Minimum discount (%)..." />

<button @onclick="ApplyDiscountFilter">Apply</button>

<h2>Minimum Metacritic Score</h2>

<input type="number" @bind="minMetacritic" min="0" max="100"
       placeholder="Minimum score (0-100)..." />

<button @onclick="ApplyMetacriticFilter">Apply</button>

<button @onclick="ResetFilters">Reset Filters</button>

@if (!string.IsNullOrEmpty(error))
{
    <p>Error: @error</p>
}
else if (deals == null)
{
    <p>Loading deals...</p>
}
else if (deals.Count == 0)
{
    <p>No deals found.</p>
}
else
{
    @foreach (var deal in deals)
    {
        <div class="deal">

            <a href="https://www.cheapshark.com/redirect?dealID=@deal.DealID"
               target="_blank"
               rel="noopener noreferrer">

                <img src="@deal.Thumb" alt="@deal.Title" width="150" />

                <h3>@deal.Title</h3>

                <p>Sale price: $@deal.SalePrice</p>
                <p>Normal price: $@deal.NormalPrice</p>

                <p>Discount: @FormatSavings(deal.Savings)</p>

                @if (!string.IsNullOrEmpty(deal.MetacriticScore)
                    && deal.MetacriticScore != "0")
                {
                    <p>Metacritic score: @deal.MetacriticScore/100</p>
                }
                else
                {
                    <p>Metacritic score: Not available</p>
                }

                <p>Store: @GetStoreName(deal.StoreID)</p>

            </a>

            <button @onclick="() => ShowPriceHistory(deal.GameID, deal.Title)">
                Show Price History
            </button>

            @if (selectedGameTitle == deal.Title)
            {
                <div>
                    @if (loadingPriceHistory)
                    {
                        <p>Loading price history...</p>
                    }
                    else if (!string.IsNullOrEmpty(priceHistoryError))
                    {
                        <p>@priceHistoryError</p>
                    }
                    else if (priceHistory?.CheapestPriceEver != null)
                    {
                        <h4>Price History for @selectedGameTitle</h4>

                        <p>
                            Lowest price ever:
                            $@priceHistory.CheapestPriceEver.Price
                        </p>

                        <p>
                            Date:
                            @DateTimeOffset.FromUnixTimeSeconds(
                                priceHistory.CheapestPriceEver.Date
                            ).ToLocalTime().ToString("dd MMM yyyy")
                        </p>
                    }
                </div>
            }

        </div>
    }
}

@if (deals != null && deals.Count > 0)
{
    <p>
        Showing @deals.Count deals on page @(currentPage + 1)
        of @totalPages pages.
    </p>

    <div>
        <button @onclick="PreviousPage" disabled="@(currentPage == 0)">
            Previous
        </button>

        <span>Page @(currentPage + 1) of @totalPages</span>

        <button @onclick="NextPage" disabled="@(currentPage >= totalPages - 1)">
            Next
        </button>
    </div>
}

@code {
    private List<Deal>? deals;
    private List<Store> stores = new List<Store>();
    private string error = "";

    private int currentPage = 0;
    private int totalPages = 0;
    private int pageSize = 30;

    private string sortBy = "DealRating";
    private string searchTitle = "";
    private string selectedStore = "";
    private string minPrice = "";
    private string maxPrice = "";
    private string minDiscount = "";
    private string minMetacritic = "";

    private GamePriceHistory? priceHistory;
    private string selectedGameTitle = "";
    private string priceHistoryError = "";
    private bool loadingPriceHistory = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeals();
    }

    // Load deals for the selected page
    private async Task LoadDeals()
    {
        try
        {
            error = "";
            deals = null;

            string title = Uri.EscapeDataString(searchTitle);

            string storeFilter = "";

            if (!string.IsNullOrEmpty(selectedStore))
            {
                storeFilter = $"&storeID={selectedStore}";
            }

            string priceFilter = "";

            if (!string.IsNullOrEmpty(minPrice))
            {
                priceFilter += $"&lowerPrice={minPrice}";
            }

            if (!string.IsNullOrEmpty(maxPrice))
            {
                priceFilter += $"&upperPrice={maxPrice}";
            }

            string metacriticFilter = "";

            if (!string.IsNullOrEmpty(minMetacritic))
            {
                metacriticFilter = $"&metacritic={minMetacritic}";
            }

            var response = await Http.GetAsync(
                $"deals?title={title}&sortBy={sortBy}&pageSize={pageSize}&pageNumber={currentPage}{storeFilter}{priceFilter}{metacriticFilter}"
            );

            response.EnsureSuccessStatusCode();

            // Get the total number of pages from the API
            if (response.Headers.TryGetValues("X-Total-Page-Count", out var pageCount))
            {
                int.TryParse(pageCount.FirstOrDefault(), out totalPages);
            }

            var allDeals = await response.Content.ReadFromJsonAsync<List<Deal>>()
                ?? new List<Deal>();

            // Filter deals by minimum discount
            if (!string.IsNullOrEmpty(minDiscount))
            {
                allDeals = allDeals.Where(deal =>
                    double.TryParse(deal.Savings, out double savings)
                    && savings >= double.Parse(minDiscount)
                ).ToList();
            }

            deals = allDeals;

            stores = await Http.GetFromJsonAsync<List<Store>>("stores")
                ?? new List<Store>();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            deals = new List<Deal>();
            totalPages = 0;
        }
    }

    // Format the discount percentage
    private string FormatSavings(string savings)
    {
        if (double.TryParse(savings, out double percentage))
        {
            return $"{Math.Round(percentage)}%";
        }

        return "Not available";
    }

    // Search for games by title
    private async Task SearchGames()
    {
        currentPage = 0;
        await LoadDeals();
    }

    // Clear the search
    private async Task ClearSearch()
    {
        searchTitle = "";
        currentPage = 0;
        await LoadDeals();
    }

    // Apply the selected sorting option
    private async Task ApplySort()
    {
        currentPage = 0;
        await LoadDeals();
    }

    // Apply the selected store filter
    private async Task ApplyStoreFilter()
    {
        currentPage = 0;
        await LoadDeals();
    }

    // Apply the price filters
    private async Task ApplyPriceFilter()
    {
        double min = 0;
        double max = 0;

        if (!string.IsNullOrEmpty(minPrice))
        {
            if (!double.TryParse(minPrice, out min) || min < 0)
            {
                error = "Please enter a valid minimum price.";
                return;
            }
        }

        if (!string.IsNullOrEmpty(maxPrice))
        {
            if (!double.TryParse(maxPrice, out max) || max < 0)
            {
                error = "Please enter a valid maximum price.";
                return;
            }
        }

        if (!string.IsNullOrEmpty(minPrice) && !string.IsNullOrEmpty(maxPrice))
        {
            if (min > max)
            {
                error = "Minimum price cannot be higher than maximum price.";
                return;
            }
        }

        error = "";
        currentPage = 0;
        await LoadDeals();
    }

    // Apply the minimum discount filter
    private async Task ApplyDiscountFilter()
    {
        if (!string.IsNullOrEmpty(minDiscount))
        {
            if (!double.TryParse(minDiscount, out double discount)
                || discount < 0 || discount > 100)
            {
                error = "Please enter a discount between 0 and 100.";
                return;
            }
        }

        error = "";
        currentPage = 0;
        await LoadDeals();
    }

    // Apply the minimum Metacritic score
    private async Task ApplyMetacriticFilter()
    {
        if (!string.IsNullOrEmpty(minMetacritic))
        {
            if (!int.TryParse(minMetacritic, out int score)
                || score < 0 || score > 100)
            {
                error = "Please enter a Metacritic score between 0 and 100.";
                return;
            }
        }

        error = "";
        currentPage = 0;
        await LoadDeals();
    }

    // Move to the next page
    private async Task NextPage()
    {
        if (currentPage < totalPages - 1)
        {
            currentPage++;
            await LoadDeals();
        }
    }

    // Move to the previous page
    private async Task PreviousPage()
    {
        if (currentPage > 0)
        {
            currentPage--;
            await LoadDeals();
        }
    }

    // Reset all filters
    private async Task ResetFilters()
    {
        searchTitle = "";
        selectedStore = "";
        minPrice = "";
        maxPrice = "";
        minDiscount = "";
        minMetacritic = "";
        sortBy = "DealRating";
        currentPage = 0;
        error = "";

        await LoadDeals();
    }

    // Find the store name using its ID
    private string GetStoreName(string storeID)
    {
        var store = stores.FirstOrDefault(s => s.storeID == storeID);

        if (store == null)
        {
            return "Unknown store";
        }

        return store.storeName;
    }

    // Load the historical lowest price for a game
    private async Task ShowPriceHistory(string gameID, string title)
    {
        try
        {
            loadingPriceHistory = true;
            priceHistoryError = "";
            priceHistory = null;
            selectedGameTitle = title;

            priceHistory = await Http.GetFromJsonAsync<GamePriceHistory>(
                $"games?id={gameID}"
            );

            if (priceHistory?.CheapestPriceEver == null)
            {
                priceHistoryError = "Price history is not available.";
            }
        }
        catch
        {
            priceHistoryError = "Could not load price history.";
        }
        finally
        {
            loadingPriceHistory = false;
        }
    }
}
